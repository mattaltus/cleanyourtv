<?xml version="1.0" encoding="utf-8"?>
<!-- Local (living room), top_bar_group: a pill inside the one frosted bar. Clear until focused, so the bar's own glass
     shows; focused and activated as pill_bg, with corners for the 36dp-high pills. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#F5FFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#596EC1FF" />
            <stroke android:width="1.5dp" android:color="#FF6EC1FF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
