<?xml version="1.0" encoding="utf-8"?>
<!-- Local (living room): one Continue watching card, 16:9, with the title over a scrim and the played fraction. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingEnd="16dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <FrameLayout
        android:id="@+id/continueCard"
        android:layout_width="176dp"
        android:layout_height="99dp"
        android:background="@drawable/continue_card"
        android:focusable="true"
        android:clickable="true">

        <ImageView
            android:id="@+id/continuePoster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no" />

        <View
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_gravity="bottom"
            android:background="@drawable/continue_scrim" />

        <TextView
            android:id="@+id/continueTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="9dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:fontFamily="@string/font_medium"
            android:importantForAccessibility="no" />

        <View
            android:id="@+id/continueTrack"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="bottom"
            android:background="#4DFFFFFF" />

        <View
            android:id="@+id/continueProgress"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="bottom"
            android:background="#FFFFFFFF" />
    </FrameLayout>
</FrameLayout>
