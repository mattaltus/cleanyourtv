<?xml version="1.0" encoding="utf-8"?>
<!-- Keys only: no accessibilityEventTypes (0), so the system never calls into the launcher for
     accessibility events, which both services ignore. Key filtering depends only on
     flagRequestFilterKeyEvents and canRequestFilterKeyEvents, not on the event types.
     stock_home_redirect is the exception: with it set, HomeKeyService adds typeWindowStateChanged at runtime.
     Local: canRetrieveWindowContent lets a mapped button ask which app is in front (RemoteKeys.foreground), and with
     flagRetrieveInteractiveWindows and flagReportViewIds click a key on TCL's on-screen remote (TclColourKey). -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRequestFilterKeyEvents|flagRetrieveInteractiveWindows|flagReportViewIds"
    android:canRequestFilterKeyEvents="true"
    android:canRetrieveWindowContent="true"
    android:description="@string/home_key_description" />
